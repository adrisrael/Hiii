const THEMES = {
    sunrise: {
        color: '#ffb347',
        bg1: '#ff7b7b',
        bg2: '#ffb347',
        ground: '#ffe066'
    },
    neon: {
        color: '#00ffd5',
        bg1: '#1a0033',
        bg2: '#000011',
        ground: '#00ffd5'
    },
    forest: {
        color: '#00ff9d',
        bg1: '#2b9348',
        bg2: '#007f5f',
        ground: '#55a630'
    },
    lava: {
        color: '#ff4d00',
        bg1: '#ff0000',
        bg2: '#6a040f',
        ground: '#ff8800'
    }
};

function generateRandomLevel(length, spacing) {
    const obs = [];
    const modes = ['cube', 'ship', 'ball', 'ufo', 'wave'];
    let currentMode = 'cube';
    let lastPortal = 0;
    
    for (let x = 400; x < length; x += spacing + Math.random() * 100) {
        const rand = Math.random();
        
        if (rand < 0.65) {
            obs.push({x, type: 'spike', w: 48, h: 62});
        } else if (rand < 0.85) {
            obs.push({x, type: 'block', w: 60, h: 60});
        } else if (x - lastPortal > 800) {
            const newMode = modes[Math.floor(Math.random() * modes.length)];
            if (newMode !== currentMode) {
                obs.push({x, type: 'portal', mode: newMode, w: 40, h: 100});
                currentMode = newMode;
                lastPortal = x;
            }
        }
    }
    
    return obs;
}

// ════════════════════════════════════════════════════════════════════════
// CONTROLS
// ════════════════════════════════════════════════════════════════════════

document.addEventListener('keydown', e => {
    if (e.code === 'Space' && gameState === 'playing') {
        e.preventDefault();
        pressing = true;
    }

    if (gameState === 'create') {
        if (e.code === 'ArrowRight') {
            editorCamX += 80;
        }
        if (e.code === 'ArrowLeft') {
            editorCamX = Math.max(0, editorCamX - 80);
        }
    }
});

document.addEventListener('keyup', e => {
    if (e.code === 'Space') {
        pressing = false;
    }
});

canvas.addEventListener('mousedown', () => {
    if (gameState === 'playing') {
        pressing = true;
        return;
    }
    if (gameState === 'create') {
        placeEditorObstacle();
    }
});

canvas.addEventListener('mouseup', () => pressing = false);

canvas.addEventListener('touchstart', e => {
    if (gameState === 'playing') {
        e.preventDefault();
        pressing = true;
    }
    if (gameState === 'create') {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        editorMouse.x = touch.clientX - rect.left;
        editorMouse.y = touch.clientY - rect.top;
        placeEditorObstacle();
    }
}, {passive: false});

canvas.addEventListener('touchend', e => {
    e.preventDefault();
    pressing = false;
}, {passive: false});

canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    editorMouse.x = e.clientX - rect.left;
    editorMouse.y = e.clientY - rect.top;
});

canvas.addEventListener('wheel', e => {
    if (gameState !== 'create') return;
    e.preventDefault();
    editorCamX = Math.max(0, editorCamX + e.deltaY * 0.8);
}, {passive: false});

// ════════════════════════════════════════════════════════════════════════
// UI FUNCTIONS
// ════════════════════════════════════════════════════════════════════════

function showMainMenu() {
    gameState = 'menu';
    document.getElementById('mainMenu').style.display = 'flex';
    document.getElementById('levelSelect').style.display = 'none';
    document.getElementById('createEditor').style.display = 'none';
    document.getElementById('gameUI').style.display = 'none';
    document.getElementById('deathScreen').style.display = 'none';
    document.getElementById('victoryScreen').style.display = 'none';
}

function showLevelSelect() {
    gameState = 'levelSelect';
    document.getElementById('mainMenu').style.display = 'none';
    document.getElementById('levelSelect').style.display = 'flex';
    document.getElementById('createEditor').style.display = 'none';
    renderLevelGrid();
}

function showCreateEditor() {
    gameState = 'create';
    document.getElementById('mainMenu').style.display = 'none';
    document.getElementById('levelSelect').style.display = 'none';
    document.getElementById('gameUI').style.display = 'none';
    document.getElementById('deathScreen').style.display = 'none';
    document.getElementById('victoryScreen').style.display = 'none';
    document.getElementById('createEditor').style.display = 'flex';

    initEditorLevel();
    requestAnimationFrame(editorLoop);
}

function renderLevelGrid() {
    const grid = document.getElementById('levelGrid');
    grid.innerHTML = '';
    
    LEVELS.forEach((level, index) => {
        const card = document.createElement('div');
        card.className = 'level-card' + (level.unlocked ? '' : ' locked');
        card.innerHTML = `
            <h3>${level.name}</h3>
            <span class="difficulty ${level.difficulty}">${level.difficulty.toUpperCase()}</span>
        `;
        
        if (level.unlocked) {
            card.onclick = () => startLevel(index);
        }
        
        grid.appendChild(card);
    });
}

function startLevel(index) {
    currentLevelIndex = index;
    currentLevel = LEVELS[index];
    
    gameState = 'playing';
    document.getElementById('levelSelect').style.display = 'none';
    document.getElementById('gameUI').style.display = 'flex';
    
    resetLevel();
    attempts = 1;
    jumps = 0;
    
    requestAnimationFrame(gameLoop);
}

function resetLevel() {
    player.x = 220;
    player.y = groundY - player.size;
    player.vy = 0;
    player.rot = 0;
    player.rotTarget = 0;
    player.trail = [];
    player.mode = 'cube';
    player.onGround = false;
    player.color = currentLevel.color;
    
    camX = 0;
    progress = 0;
    dead = false;
    pressing = false;
    wasPressed = false;
    particles = [];
    
    updateUI();
}

function restartLevel() {
    document.getElementById('deathScreen').style.display = 'none';
    gameState = 'playing';
    resetLevel();
    attempts++;
    requestAnimationFrame(gameLoop);
}

function exitLevel() {
    gameState = 'menu';
    document.getElementById('gameUI').style.display = 'none';
    document.getElementById('deathScreen').style.display = 'none';
    document.getElementById('victoryScreen').style.display = 'none';
    showLevelSelect();
}

function initEditorLevel() {
    const levelData = buildEditorLevel();
    editorLevel = {
        ...levelData,
        obstacles: []
    };
    editorCamX = 0;
}

function buildEditorLevel() {
    const name = document.getElementById('createName').value.trim() || 'My Level';
    const difficulty = document.getElementById('createDifficulty').value;
    const length = Math.max(2000, Math.min(12000, Number(document.getElementById('createLength').value) || 4500));
    const themeKey = document.getElementById('createTheme').value;
    const theme = THEMES[themeKey] || THEMES.sunrise;

    return {
        name,
        difficulty,
        color: theme.color,
        bg1: theme.bg1,
        bg2: theme.bg2,
        ground: theme.ground,
        unlocked: true,
        length
    };
}

function placeEditorObstacle() {
    if (!editorLevel) return;
    const obstacleType = document.getElementById('createObstacle').value;
    const portalMode = document.getElementById('createPortalMode').value;

    const x = Math.round(editorCamX + editorMouse.x);
    if (x < 200) return;

    if (obstacleType === 'spike') {
        editorLevel.obstacles.push({ x, type: 'spike', w: 48, h: 62 });
    } else if (obstacleType === 'block') {
        editorLevel.obstacles.push({ x, type: 'block', w: 60, h: 60 });
    } else {
        editorLevel.obstacles.push({ x, type: 'portal', mode: portalMode, w: 40, h: 100 });
    }

    editorLevel.obstacles.sort((a, b) => a.x - b.x);
}

function playtestLevel() {
    if (!editorLevel) return;
    currentLevel = {
        ...buildEditorLevel(),
        obstacles: [...editorLevel.obstacles]
    };
    currentLevelIndex = LEVELS.length;
    gameState = 'playing';
    document.getElementById('createEditor').style.display = 'none';
    document.getElementById('gameUI').style.display = 'flex';
    resetLevel();
    attempts = 1;
    jumps = 0;
    requestAnimationFrame(gameLoop);
}

function saveCustomLevel() {
    if (!editorLevel) return;
    const newLevel = {
        ...buildEditorLevel(),
        obstacles: [...editorLevel.obstacles]
    };
    const existingIndex = LEVELS.findIndex(level => level.name.toLowerCase() === newLevel.name.toLowerCase());
    if (existingIndex >= 0) {
        LEVELS[existingIndex] = newLevel;
    } else {
        LEVELS.push(newLevel);
    }
    showLevelSelect();
}

function clearCustomLevel() {
    if (!editorLevel) return;
    editorLevel.obstacles = [];
}

function removeLastObstacle() {
    if (!editorLevel || editorLevel.obstacles.length === 0) return;
    editorLevel.obstacles.pop();
}

function updateUI() {
    document.getElementById('progressUI').textContent = Math.floor(progress) + '%';
    document.getElementById('attemptUI').textContent = 'Attempt ' + attempts;
    document.getElementById('modeUI').textContent = player.mode.toUpperCase();
}

// ════════════════════════════════════════════════════════════════════════
// GAME LOOP
// ════════════════════════════════════════════════════════════════════════

function gameLoop() {
    if (gameState !== 'playing') return;
    
    update();
    draw();
    
    if (!dead && progress < 100) {
        requestAnimationFrame(gameLoop);
    }
}

function update() {
    if (dead) return;
    
    const phys = PHYSICS[player.mode];
    
    // Mode-specific input
    if (player.mode === 'cube') {
        // Continuous jumping - if holding and on ground, jump
        if (pressing && player.onGround) {
            player.vy = phys.jumpVel;
            jumps++;
            player.onGround = false; // Prevent double jump in same frame
        }
    } else if (player.mode === 'ship') {
        if (pressing) {
            player.vy += phys.upVel;
        } else {
            player.vy += phys.downVel;
        }
        player.vy = Math.max(-12, Math.min(12, player.vy));
    } else if (player.mode === 'ball') {
        if (pressing && !wasPressed && player.onGround) {
            player.vy = phys.jumpVel;
            jumps++;
        }
    } else if (player.mode === 'ufo') {
        if (pressing && !wasPressed) {
            player.vy = phys.jumpVel;
            jumps++;
        }
    } else if (player.mode === 'wave') {
        if (pressing) {
            player.vy = phys.upVel;
        } else {
            player.vy = phys.downVel;
        }
    }
    
    wasPressed = pressing;
    
    // Gravity
    if (player.mode !== 'wave') {
        player.vy += phys.gravity;
    }
    
    player.y += player.vy;
    
    // Ground collision
    player.onGround = false;
    if (player.mode !== 'ship' && player.mode !== 'wave') {
        if (player.y + player.size >= groundY) {
            player.y = groundY - player.size;
            player.vy = 0;
            player.onGround = true;
            player.rot = Math.round(player.rot / 90) * 90;
        }
        
        // Platform/block collision - check if landing on top
        for (let obs of currentLevel.obstacles) {
            if (obs.type !== 'block') continue;
            
            const ox = obs.x - camX;
            if (ox < -100 || ox > W + 100) continue;
            
            const obsY = groundY - obs.h;
            const obsTop = obsY;
            const obsBottom = obsY + obs.h;
            const obsLeft = ox;
            const obsRight = ox + obs.w;
            
            const playerBottom = player.y + player.size;
            const playerLeft = player.x + 5;
            const playerRight = player.x + player.size - 5;
            
            // Check if landing on top of block
            if (player.vy >= 0 && 
                playerBottom >= obsTop && 
                playerBottom <= obsTop + 10 &&
                playerRight > obsLeft && 
                playerLeft < obsRight) {
                player.y = obsTop - player.size;
                player.vy = 0;
                player.onGround = true;
                player.rot = Math.round(player.rot / 90) * 90;
                break;
            }
        }
    }
    
    // ABSOLUTE FLOOR BOUNDARY - CAN NEVER GO BELOW GROUND
    if (player.y + player.size > groundY) {
        player.y = groundY - player.size;
        player.vy = Math.min(0, player.vy);
    }
    
    // Ship and wave also respect floor
    if (player.mode === 'ship' || player.mode === 'wave') {
        if (player.y + player.size >= groundY) {
            player.y = groundY - player.size;
            player.vy = Math.min(0, player.vy);
        }
    }
    
    // Ceiling
    if (player.y <= 0) {
        if (player.mode === 'ship' || player.mode === 'wave') {
            player.y = 0;
            player.vy = Math.max(0, player.vy);
        } else {
            die();
            return;
        }
    }
    
    // Rotation - SMOOTH AND CONSTANT like real GD
    if (player.mode === 'cube') {
        if (!player.onGround) {
            // Constant smooth rotation while in air
            player.rot += 5.5;
        } else {
            // Snap to nearest 90 degrees when on ground
            const target = Math.round(player.rot / 90) * 90;
            const diff = target - player.rot;
            if (Math.abs(diff) > 2) {
                player.rot += diff * 0.3;
            } else {
                player.rot = target;
            }
        }
    } else if (player.mode === 'ship') {
        player.rot = player.vy * 2.5;
    } else if (player.mode === 'ball') {
        player.rot += 8;
    } else if (player.mode === 'ufo') {
        if (!player.onGround) {
            player.rot += 3;
        }
    }
    
    // Trail
    if (player.mode === 'ship' || player.mode === 'wave') {
        player.trail.push({
            x: player.x + camX,
            y: player.y + player.size / 2,
            life: 1
        });
        if (player.trail.length > 30) player.trail.shift();
    }
    
    for (let p of player.trail) {
        p.life -= 0.04;
    }
    
    // Particles
    for (let i = particles.length - 1; i >= 0; i--) {
        particles[i].life -= 0.03;
        particles[i].y += particles[i].vy;
        particles[i].x += particles[i].vx;
        particles[i].vy += 0.4;
        if (particles[i].life <= 0) particles.splice(i, 1);
    }
    
    // Camera
    camX += phys.speed;
    progress = Math.min(100, (camX / currentLevel.length) * 100);
    
    // Collision
    checkCollisions();
    
    // Victory
    if (progress >= 100) {
        victory();
    }
    
    updateUI();
}

function checkCollisions() {
    for (let obs of currentLevel.obstacles) {
        const ox = obs.x - camX; // Screen X position
        if (ox < -100 || ox > W + 100) continue;
        
        // Portal
        if (obs.type === 'portal') {
            if (player.x + player.size > ox &&
                player.x < ox + obs.w &&
                player.y + player.size > groundY - obs.h &&
                player.y < groundY) {
                if (player.mode !== obs.mode) {
                    player.mode = obs.mode;
                    player.trail = [];
                }
            }
            continue;
        }
        
        // Obstacle position on screen
        const obsY = groundY - obs.h;
        
        // Hitbox with small margin for fairness
        const margin = 5;
        
        const playerLeft = player.x + margin;
        const playerRight = player.x + player.size - margin;
        const playerTop = player.y + margin;
        const playerBottom = player.y + player.size - margin;
        
        const obsLeft = ox;
        const obsRight = ox + obs.w;
        const obsTop = obsY;
        const obsBottom = obsY + obs.h;
        
        // For blocks, check if landing on top (safe zone)
        if (obs.type === 'block') {
            const landingZone = playerBottom <= obsTop + 8 && player.vy >= 0;
            
            // If landing on top safely, skip collision
            if (landingZone && 
                playerRight > obsLeft && 
                playerLeft < obsRight) {
                continue;
            }
        }
        
        // AABB collision for spikes and side/bottom collisions with blocks
        if (playerRight > obsLeft && 
            playerLeft < obsRight && 
            playerBottom > obsTop && 
            playerTop < obsBottom) {
            die();
            return;
        }
    }
}

function die() {
    dead = true;
    gameState = 'dead';
    
    // Death particles
    for (let i = 0; i < 30; i++) {
        particles.push({
            x: player.x + camX + player.size / 2,
            y: player.y + player.size / 2,
            vx: (Math.random() - 0.5) * 12,
            vy: (Math.random() - 0.5) * 12,
            life: 1.5
        });
    }
    
    document.getElementById('deathProgress').textContent = 'Progress: ' + Math.floor(progress) + '%';
    document.getElementById('deathAttempt').textContent = 'Attempt: ' + attempts;
    
    setTimeout(() => {
        document.getElementById('deathScreen').style.display = 'flex';
    }, 600);
}

function victory() {
    dead = true;
    gameState = 'victory';
    
    // Unlock next level
    if (currentLevelIndex < LEVELS.length - 1) {
        LEVELS[currentLevelIndex + 1].unlocked = true;
    }
    
    document.getElementById('victoryAttempts').textContent = 'Attempts: ' + attempts;
    document.getElementById('victoryJumps').textContent = 'Jumps: ' + jumps;
    
    setTimeout(() => {
        document.getElementById('victoryScreen').style.display = 'flex';
    }, 500);
}

// ════════════════════════════════════════════════════════════════════════
// RENDERING
// ════════════════════════════════════════════════════════════════════════

function draw() {
    ctx.clearRect(0, 0, W, H);
    
    // Background
    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, currentLevel.bg1);
    bg.addColorStop(1, currentLevel.bg2);
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);
    
    // Grid
    ctx.strokeStyle = 'rgba(0, 0, 0, 0.1)';
    ctx.lineWidth = 2;
    const grid = 70;
    for (let x = -camX % grid - grid; x < W + grid; x += grid) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, H);
        ctx.stroke();
    }
    
    // Ground
    ctx.fillStyle = currentLevel.ground;
    ctx.fillRect(0, groundY, W, H - groundY);
    
    ctx.strokeStyle = '#000';
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(0, groundY);
    ctx.lineTo(W, groundY);
    ctx.stroke();
    
    // Obstacles
    for (let obs of currentLevel.obstacles) {
        const ox = obs.x - camX;
        if (ox < -100 || ox > W + 100) continue;
        
        if (obs.type === 'spike') {
            drawSpike(ox, groundY, obs.w, obs.h);
        } else if (obs.type === 'block') {
            drawBlock(ox, groundY - obs.h, obs.w, obs.h);
        } else if (obs.type === 'portal') {
            drawPortal(ox, groundY - obs.h, obs.w, obs.h, obs.mode);
        }
    }
    
    // Particles
    for (let p of particles) {
        if (p.life <= 0) continue;
        ctx.globalAlpha = p.life * 0.8;
        ctx.fillStyle = player.color;
        ctx.fillRect(p.x - camX, p.y, 6, 6);
    }
    ctx.globalAlpha = 1;
    
    // Trail
    for (let p of player.trail) {
        if (p.life <= 0) continue;
        ctx.globalAlpha = p.life * 0.6;
        ctx.fillStyle = player.color;
        ctx.fillRect(p.x - camX - 4, p.y - 4, 8, 8);
    }
    ctx.globalAlpha = 1;
    
    // Player
    if (!dead) {
        drawPlayer();
    }
}

function editorLoop() {
    if (gameState !== 'create') return;
    drawEditor();
    requestAnimationFrame(editorLoop);
}

function drawEditor() {
    if (!editorLevel) return;
    const meta = buildEditorLevel();
    editorLevel = { ...editorLevel, ...meta, obstacles: editorLevel.obstacles };
    editorCamX = Math.max(0, Math.min(editorCamX, Math.max(0, editorLevel.length - W * 0.6)));
    ctx.clearRect(0, 0, W, H);

    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, editorLevel.bg1);
    bg.addColorStop(1, editorLevel.bg2);
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';
    ctx.lineWidth = 2;
    const grid = 70;
    for (let x = -editorCamX % grid - grid; x < W + grid; x += grid) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, H);
        ctx.stroke();
    }

    ctx.fillStyle = editorLevel.ground;
    ctx.fillRect(0, groundY, W, H - groundY);

    ctx.strokeStyle = '#000';
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(0, groundY);
    ctx.lineTo(W, groundY);
    ctx.stroke();

    for (let obs of editorLevel.obstacles) {
        const ox = obs.x - editorCamX;
        if (ox < -100 || ox > W + 100) continue;
        if (obs.type === 'spike') {
            drawSpike(ox, groundY, obs.w, obs.h);
        } else if (obs.type === 'block') {
            drawBlock(ox, groundY - obs.h, obs.w, obs.h);
        } else if (obs.type === 'portal') {
            drawPortal(ox, groundY - obs.h, obs.w, obs.h, obs.mode);
        }
    }

    ctx.strokeStyle = 'rgba(255,255,255,0.7)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(editorMouse.x, 0);
    ctx.lineTo(editorMouse.x, H);
    ctx.stroke();
}

function drawPlayer() {
    ctx.save();
    ctx.translate(player.x + player.size / 2, player.y + player.size / 2);
    
    if (player.mode === 'cube') {
        // Rotate the cube but DON'T add 45° offset - keep it flat
        ctx.rotate(player.rot * Math.PI / 180);
        ctx.shadowColor = player.color;
        ctx.shadowBlur = 20;
        
        // Black outline
        ctx.fillStyle = '#000';
        ctx.fillRect(-player.size / 2 - 3, -player.size / 2 - 3, player.size + 6, player.size + 6);
        
        // Main cube
        ctx.fillStyle = player.color;
        ctx.fillRect(-player.size / 2, -player.size / 2, player.size, player.size);
        
        // Inner detail
        ctx.fillStyle = '#fff';
        const innerSize = player.size * 0.3;
        ctx.fillRect(-innerSize / 2, -innerSize / 2, innerSize, innerSize);
        
    } else if (player.mode === 'ship') {
        ctx.rotate(player.rot * Math.PI / 180);
        ctx.shadowColor = player.color;
        ctx.shadowBlur = 20;
        
        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.moveTo(player.size / 2 + 3, 0);
        ctx.lineTo(-player.size / 2 - 3, -player.size / 2.5);
        ctx.lineTo(-player.size / 2 - 3, player.size / 2.5);
        ctx.closePath();
        ctx.fill();
        
        ctx.fillStyle = player.color;
        ctx.beginPath();
        ctx.moveTo(player.size / 2, 0);
        ctx.lineTo(-player.size / 2, -player.size / 2.5);
        ctx.lineTo(-player.size / 2, player.size / 2.5);
        ctx.closePath();
        ctx.fill();
        
    } else if (player.mode === 'ball') {
        ctx.rotate(player.rot * Math.PI / 180);
        ctx.shadowColor = player.color;
        ctx.shadowBlur = 20;
        
        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.arc(0, 0, player.size / 2 + 3, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.fillStyle = player.color;
        ctx.beginPath();
        ctx.arc(0, 0, player.size / 2, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.fillStyle = '#fff';
        ctx.fillRect(-player.size / 6, -player.size / 2, player.size / 3, player.size);
        
    } else if (player.mode === 'ufo') {
        ctx.rotate(player.rot * Math.PI / 180);
        ctx.shadowColor = player.color;
        ctx.shadowBlur = 20;
        
        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.ellipse(0, 0, player.size / 2 + 3, player.size / 3 + 3, 0, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.fillStyle = player.color;
        ctx.beginPath();
        ctx.ellipse(0, 0, player.size / 2, player.size / 3, 0, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.fillRect(-player.size / 4, -player.size / 5, player.size / 2, player.size / 2.5);
        
    } else if (player.mode === 'wave') {
        ctx.shadowColor = player.color;
        ctx.shadowBlur = 20;
        
        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.moveTo(player.size / 2 + 3, 0);
        ctx.lineTo(0, player.size / 2 + 3);
        ctx.lineTo(-player.size / 2 - 3, 0);
        ctx.lineTo(0, -player.size / 2 - 3);
        ctx.closePath();
        ctx.fill();
        
        ctx.fillStyle = player.color;
        ctx.beginPath();
        ctx.moveTo(player.size / 2, 0);
        ctx.lineTo(0, player.size / 2);
        ctx.lineTo(-player.size / 2, 0);
        ctx.lineTo(0, -player.size / 2);
        ctx.closePath();
        ctx.fill();
    }
    
    ctx.shadowBlur = 0;
    ctx.restore();
}

function drawSpike(x, y, w, h) {
    ctx.fillStyle = '#000';
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 3;
    ctx.shadowColor = '#fff';
    ctx.shadowBlur = 10;
    
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x + w / 2, y - h);
    ctx.lineTo(x + w, y);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    
    ctx.shadowBlur = 0;
}

function drawBlock(x, y, w, h) {
    ctx.fillStyle = '#000';
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 3;
    ctx.shadowColor = '#fff';
    ctx.shadowBlur = 10;
    
    ctx.fillRect(x, y, w, h);
    ctx.strokeRect(x, y, w, h);
    
    ctx.shadowBlur = 0;
}

function drawPortal(x, y, w, h, mode) {
    const colors = {
        cube: '#00ff9d',
        ship: '#00ffff',
        ball: '#ff00ff',
        ufo: '#ffaa00',
        wave: '#ff0088'
    };
    
    ctx.strokeStyle = colors[mode];
    ctx.lineWidth = 4;
    ctx.shadowColor = colors[mode];
    ctx.shadowBlur = 25;
    
    ctx.strokeRect(x, y, w, h);
    
    ctx.globalAlpha = 0.3;
    ctx.fillStyle = colors[mode];
    ctx.fillRect(x, y, w, h);
    ctx.globalAlpha = 1;
    
    ctx.shadowBlur = 0;
}

