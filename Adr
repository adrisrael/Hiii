<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Geometry Dash</title>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@800;900&display=swap');
    
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        user-select: none;
        -webkit-user-select: none;
        touch-action: manipulation;
    }
    
    body {
        background: #000;
        overflow: hidden;
        height: 100vh;
        font-family: 'Poppins', sans-serif;
    }
    
    canvas {
        display: block;
        image-rendering: pixelated;
    }
    
    /* Main Menu */
    #mainMenu {
        position: fixed;
        inset: 0;
        background: linear-gradient(180deg, #287bff 0%, #1a5fd6 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 100;
    }
    
    #mainMenu h1 {
        font-size: 7rem;
        font-weight: 900;
        color: #fff;
        text-shadow: 
            0 10px 0 rgba(0,0,0,0.3),
            0 15px 30px rgba(0,0,0,0.5);
        letter-spacing: 0.02em;
        margin-bottom: 3rem;
    }
    
    .menu-btn {
        padding: 1.2rem 4rem;
        font-size: 2rem;
        font-weight: 900;
        border: none;
        background: linear-gradient(180deg, #0dff00 0%, #00cc00 100%);
        color: #fff;
        cursor: pointer;
        border-radius: 12px;
        box-shadow: 0 8px 0 #008800, 0 12px 25px rgba(0,0,0,0.4);
        transition: all 0.1s;
        text-shadow: 0 3px 5px rgba(0,0,0,0.4);
        margin: 0.5rem;
    }
    
    .menu-btn:hover {
        transform: translateY(3px);
        box-shadow: 0 5px 0 #008800, 0 8px 20px rgba(0,0,0,0.4);
    }
    
    .menu-btn:active {
        transform: translateY(6px);
        box-shadow: 0 2px 0 #008800, 0 4px 15px rgba(0,0,0,0.4);
    }
    
    /* Level Select */
    #levelSelect {
        position: fixed;
        inset: 0;
        background: linear-gradient(180deg, #ff6347 0%, #ff4500 100%);
        display: none;
        flex-direction: column;
        align-items: center;
        padding: 3rem;
        z-index: 100;
        overflow-y: auto;
    }
    
    #levelSelect h2 {
        font-size: 4rem;
        color: #fff;
        text-shadow: 0 6px 0 rgba(0,0,0,0.3);
        margin-bottom: 2rem;
        font-weight: 900;
    }
    
    .level-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        width: 100%;
    }
    
    .level-card {
        background: linear-gradient(180deg, #fff 0%, #e8e8e8 100%);
        border: 5px solid #000;
        border-radius: 15px;
        padding: 2rem;
        cursor: pointer;
        box-shadow: 0 8px 0 #000, 0 12px 25px rgba(0,0,0,0.5);
        transition: all 0.1s;
    }
    
    .level-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 11px 0 #000, 0 15px 30px rgba(0,0,0,0.5);
    }
    
    .level-card:active {
        transform: translateY(3px);
        box-shadow: 0 5px 0 #000, 0 8px 20px rgba(0,0,0,0.5);
    }
    
    .level-card.locked {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .level-card h3 {
        font-size: 1.8rem;
        color: #000;
        margin-bottom: 1rem;
        font-weight: 900;
    }
    
    .level-card .difficulty {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 900;
        font-size: 1rem;
    }
    
    .difficulty.easy { background: #00ff00; color: #000; }
    .difficulty.normal { background: #ffff00; color: #000; }
    .difficulty.hard { background: #ff6600; color: #fff; }
    .difficulty.insane { background: #ff0000; color: #fff; }
    .difficulty.demon { background: #aa00ff; color: #fff; }
    
    /* Game UI */
    #gameUI {
        position: fixed;
        top: 20px;
        left: 20px;
        right: 20px;
        display: none;
        justify-content: space-between;
        align-items: flex-start;
        z-index: 50;
        pointer-events: none;
    }
    
    .ui-stat {
        background: rgba(0,0,0,0.8);
        border: 4px solid #fff;
        border-radius: 10px;
        padding: 0.8rem 1.5rem;
        color: #fff;
        font-size: 2rem;
        font-weight: 900;
        text-shadow: 0 3px 5px rgba(0,0,0,0.8);
        margin-bottom: 0.5rem;
    }
    
    .ui-btn {
        background: rgba(0,0,0,0.8);
        border: 4px solid #fff;
        border-radius: 10px;
        padding: 0.8rem 1.5rem;
        color: #fff;
        font-size: 1.3rem;
        font-weight: 900;
        cursor: pointer;
        pointer-events: all;
        transition: all 0.1s;
    }
    
    .ui-btn:hover {
        background: rgba(50,50,50,0.9);
        transform: scale(1.05);
    }
    
    /* Death/Victory Screens */
    #deathScreen, #victoryScreen {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.95);
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 90;
    }
    
    #victoryScreen {
        background: linear-gradient(135deg, #ffd700 0%, #ff8800 100%);
    }
    
    #deathScreen h2 {
        font-size: 6rem;
        color: #ff0000;
        text-shadow: 0 8px 0 rgba(0,0,0,0.5);
        margin-bottom: 2rem;
        font-weight: 900;
        animation: shake 0.5s;
    }
    
    #victoryScreen h2 {
        font-size: 6rem;
        color: #fff;
        text-shadow: 0 8px 0 rgba(0,0,0,0.3);
        margin-bottom: 2rem;
        font-weight: 900;
        animation: bounce 1s infinite;
    }
    
    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        10%, 30%, 50%, 70%, 90% { transform: translateX(-8px); }
        20%, 40%, 60%, 80% { transform: translateX(8px); }
    }
    
    @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-15px); }
    }
    
    .death-stats, .victory-stats {
        background: rgba(255,255,255,0.2);
        border: 4px solid #fff;
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
    }
    
    .death-stats p, .victory-stats p {
        color: #fff;
        font-size: 1.8rem;
        font-weight: 900;
        text-shadow: 0 3px 5px rgba(0,0,0,0.5);
        margin: 0.5rem 0;
    }
    
    .back-btn {
        position: fixed;
        top: 20px;
        left: 20px;
        background: rgba(255,255,255,0.9);
        border: 4px solid #000;
        border-radius: 10px;
        padding: 0.8rem 1.5rem;
        font-size: 1.5rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 4px 0 #000;
        transition: all 0.1s;
        z-index: 101;
    }
    
    .back-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 0 #000;
    }
    
    .back-btn:active {
        transform: translateY(2px);
        box-shadow: 0 2px 0 #000;
    }

    /* Create Editor */
    #createEditor {
        position: fixed;
        inset: 0;
        background: linear-gradient(180deg, #7c5cff 0%, #3c2dbf 100%);
        display: none;
        flex-direction: column;
        align-items: center;
        padding: 2.5rem 3rem 3rem;
        z-index: 100;
        overflow-y: auto;
        pointer-events: none;
    }

    #createEditor h2 {
        font-size: 3.2rem;
        color: #fff;
        text-shadow: 0 6px 0 rgba(0,0,0,0.3);
        margin-bottom: 1.5rem;
        font-weight: 900;
    }

    #createEditor .back-btn {
        pointer-events: auto;
    }

    .create-panel {
        width: min(1100px, 95%);
        background: rgba(0,0,0,0.35);
        border: 4px solid #fff;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 12px 25px rgba(0,0,0,0.4);
        color: #fff;
        pointer-events: auto;
    }

    .create-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .create-row label {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-weight: 900;
        font-size: 1.1rem;
    }

    .create-row input,
    .create-row select {
        padding: 0.7rem 1rem;
        border-radius: 10px;
        border: 3px solid #000;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .create-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .create-help {
        font-size: 1.1rem;
        font-weight: 700;
        opacity: 0.9;
    }
</style>
</head>
<body>

<canvas id="c"></canvas>

<!-- Main Menu -->
<div id="mainMenu">
    <h1>GEOMETRY DASH</h1>
    <div>
        <button class="menu-btn" id="playBtn" onclick="showLevelSelect()">PLAY</button>
        <button class="menu-btn" id="createBtn">CREATE</button>
    </div>
</div>

<!-- Level Select -->
<div id="levelSelect">
    <button class="back-btn" onclick="showMainMenu()">← BACK</button>
    <h2>SELECT LEVEL</h2>
    <div class="level-grid" id="levelGrid"></div>
</div>

<!-- Create Editor -->
<div id="createEditor">
    <button class="back-btn" onclick="showMainMenu()">← BACK</button>
    <div class="create-panel">
        <h2>CREATE LEVEL</h2>
        <div class="create-row">
            <label>
                Name
                <input id="createName" type="text" value="My Level" maxlength="20">
            </label>
            <label>
                Difficulty
                <select id="createDifficulty">
                    <option value="easy">Easy</option>
                    <option value="normal">Normal</option>
                    <option value="hard">Hard</option>
                    <option value="insane">Insane</option>
                    <option value="demon">Demon</option>
                </select>
            </label>
            <label>
                Length
                <input id="createLength" type="number" min="2000" max="12000" value="4500">
            </label>
        </div>
        <div class="create-row">
            <label>
                Obstacle
                <select id="createObstacle">
                    <option value="spike">Spike</option>
                    <option value="block">Block</option>
                    <option value="portal">Portal</option>
                </select>
            </label>
            <label>
                Portal Mode
                <select id="createPortalMode">
                    <option value="cube">Cube</option>
                    <option value="ship">Ship</option>
                    <option value="ball">Ball</option>
                    <option value="ufo">UFO</option>
                    <option value="wave">Wave</option>
                </select>
            </label>
            <label>
                Theme
                <select id="createTheme">
                    <option value="sunrise">Sunrise</option>
                    <option value="neon">Neon</option>
                    <option value="forest">Forest</option>
                    <option value="lava">Lava</option>
                </select>
            </label>
        </div>
        <div class="create-actions">
            <button class="menu-btn" onclick="playtestLevel()">PLAYTEST</button>
            <button class="menu-btn" onclick="saveCustomLevel()">SAVE</button>
            <button class="menu-btn" onclick="clearCustomLevel()">CLEAR</button>
            <button class="menu-btn" onclick="removeLastObstacle()">UNDO</button>
        </div>
        <p class="create-help">Click on the canvas to place obstacles. Use ←/→ or mouse wheel to scroll.</p>
    </div>
</div>

<!-- Game UI -->
<div id="gameUI">
    <div>
        <div class="ui-stat" id="progressUI">0%</div>
        <div class="ui-stat" id="attemptUI">Attempt 1</div>
        <div class="ui-stat" id="modeUI">CUBE</div>
    </div>
    <div>
        <button class="ui-btn" onclick="exitLevel()">EXIT</button>
    </div>
</div>

<!-- Death Screen -->
<div id="deathScreen">
    <h2>LEVEL FAILED</h2>
    <div class="death-stats">
        <p id="deathProgress">Progress: 0%</p>
        <p id="deathAttempt">Attempt: 1</p>
    </div>
    <div>
        <button class="menu-btn" onclick="restartLevel()">RETRY</button>
        <button class="menu-btn" onclick="exitLevel()">EXIT</button>
    </div>
</div>

<!-- Victory Screen -->
<div id="victoryScreen">
    <h2>LEVEL COMPLETE!</h2>
    <div class="victory-stats">
        <p id="victoryAttempts">Attempts: 1</p>
        <p id="victoryJumps">Jumps: 0</p>
    </div>
    <div>
        <button class="menu-btn" onclick="showLevelSelect()">LEVELS</button>
        <button class="menu-btn" onclick="showMainMenu()">MENU</button>
    </div>
</div>

<script>
